rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{fam} {
      // Cada cuidador se registra como miembro al entrar con el código
      match /members/{uid} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      // Solo los miembros de esa familia leen y escriben sus datos
      match /{col}/{id} {
        allow read, write: if request.auth != null
          && col in ['events', 'cries']
          && exists(/databases/$(database)/documents/families/$(fam)/members/$(request.auth.uid));
      }
    }
  }
}
